# Banco de dados (PostgreSQL). Ajuste para o seu ambiente local.
DATABASE_URL="postgresql://user:password@localhost:5432/trilheo?schema=public"

# NextAuth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Innovation Copilot (Fase 6) — Gemini. Chamado só no servidor.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# E-mail transacional (Fase 7) — Resend. Sem essa chave, o convite de
# membro mostra a senha temporária na tela para repasse manual.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Trilheo <onboarding@resend.dev>"

